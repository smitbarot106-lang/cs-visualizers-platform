---
// ============================================================================
// JSON Formatter & Validator (Route: /tools/json-formatter/)
// Client-side, privacy-first, beginner-friendly JSON formatting and diagnostics
// ============================================================================

import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="JSON Formatter & Validator — Privacy-First CS Tool"
  description="Format, validate, and minify JSON with plain-English syntax error explanations. 100% client-side execution with zero data transmission."
  currentRoute="/tools/json-formatter/"
>
  <div class="tool-page-container container">
    <!-- 1. Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li><a href="/tools/">Developer Tools</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li aria-current="page">JSON Formatter & Validator</li>
      </ol>
    </nav>

    <!-- 2. Tool Heading & Privacy Declaration -->
    <header class="tool-header">
      <div class="header-badge-row">
        <span class="category-badge">DEVELOPER UTILITY</span>
        <span class="privacy-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          100% Local Browser Execution
        </span>
      </div>
      <h1 class="tool-title">JSON Formatter & Validator</h1>
      <p class="tool-lead">
        Format, inspect, and minify JSON data with plain-English syntax diagnostics and line-level error pointers. 
        Your data never leaves this device.
      </p>
    </header>

    <!-- 3. Presets & Controls Toolbar -->
    <section class="toolbar-section" aria-label="Tool Presets and Controls">
      <div class="presets-group">
        <span class="toolbar-label">Sample Presets:</span>
        <button type="button" class="preset-btn" data-preset="simple">Simple Object</button>
        <button type="button" class="preset-btn" data-preset="nested">Nested Array</button>
        <button type="button" class="preset-btn" data-preset="unicode">Unicode & Strings</button>
        <button type="button" class="preset-btn warning-preset" data-preset="invalid">Common Errors Sample</button>
      </div>

      <div class="indent-group">
        <label for="indent-select" class="toolbar-label">Indentation:</label>
        <select id="indent-select" class="indent-select" aria-label="Indentation spacing">
          <option value="2" selected>2 Spaces</option>
          <option value="4">4 Spaces</option>
        </select>
      </div>
    </section>

    <!-- 4. Interactive Editor Grid -->
    <main class="editor-grid">
      <!-- Input Column -->
      <section class="editor-col" aria-label="JSON Input">
        <div class="editor-col-header">
          <div class="col-title-group">
            <h2 class="col-title">Input JSON</h2>
            <span id="input-stats" class="col-stats" aria-live="polite">0 chars • 0 bytes</span>
          </div>
          <button type="button" id="clear-input-btn" class="action-btn-sm" aria-label="Clear input editor">
            Clear
          </button>
        </div>

        <div class="textarea-wrapper">
          <textarea
            id="json-input"
            class="code-textarea"
            placeholder="Paste or type your JSON here (e.g. {&#34;key&#34;: &#34;value&#34;})..."
            spellcheck="false"
            autocomplete="off"
            aria-label="JSON input text area"
          ></textarea>
        </div>

        <div class="input-actions-bar">
          <button type="button" id="format-btn" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 7 4 4 20 4 20 7"></polyline>
              <line x1="9" y1="20" x2="15" y2="20"></line>
              <line x1="12" y1="4" x2="12" y2="20"></line>
            </svg>
            <span>Format JSON</span>
          </button>

          <button type="button" id="validate-btn" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>Validate Only</span>
          </button>

          <button type="button" id="minify-btn" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 14 10 14 10 20"></polyline>
              <polyline points="20 10 14 10 14 4"></polyline>
              <line x1="14" y1="10" x2="21" y2="3"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
            <span>Minify</span>
          </button>
        </div>
      </section>

      <!-- Output Column -->
      <section class="editor-col" aria-label="JSON Output and Status">
        <div class="editor-col-header">
          <div class="col-title-group">
            <h2 class="col-title">Output Result</h2>
            <span id="output-stats" class="col-stats" aria-live="polite">Ready</span>
          </div>
          <button type="button" id="copy-output-btn" class="action-btn-sm" aria-label="Copy formatted JSON to clipboard">
            <span id="copy-btn-text">Copy Output</span>
          </button>
        </div>

        <div class="textarea-wrapper">
          <textarea
            id="json-output"
            class="code-textarea"
            readonly
            placeholder="Formatted or minified output will appear here..."
            aria-label="JSON output area"
            spellcheck="false"
          ></textarea>
        </div>

        <!-- Status Feedback Announcement -->
        <div id="status-card" class="status-card status-neutral" role="status" aria-live="polite">
          <div class="status-header">
            <span id="status-icon" class="status-icon" aria-hidden="true">ℹ</span>
            <strong id="status-title" class="status-title">Status: Ready</strong>
          </div>
          <p id="status-desc" class="status-desc">Enter JSON or select a sample preset above, then click Format or Validate.</p>
          <div id="status-details" class="status-details" style="display: none;">
            <div id="diagnostic-badge" class="diagnostic-badge"></div>
            <p id="diagnostic-suggestion" class="diagnostic-suggestion"></p>
            <pre id="diagnostic-snippet" class="diagnostic-snippet"></pre>
          </div>
        </div>
      </section>
    </main>

    <!-- 5. Educational Explanation Section -->
    <article class="educational-section">
      <header class="edu-header">
        <span class="edu-badge">COMPUTER SCIENCE FOUNDATIONS</span>
        <h2 class="edu-title">Understanding JSON (JavaScript Object Notation)</h2>
        <p class="edu-lead">
          JSON is the standard text-based data format specified by <strong>RFC 8259</strong> and <strong>ECMA-404</strong>. 
          While derived from JavaScript syntax, JSON is completely language-independent and strictly enforced.
        </p>
      </header>

      <div class="edu-grid">
        <div class="edu-card">
          <h3 class="edu-card-title">The 6 Permitted Data Types</h3>
          <ul class="edu-list">
            <li><strong>String:</strong> Unicode text strictly enclosed in double quotes (<code>"example"</code>).</li>
            <li><strong>Number:</strong> Integer or floating point (e.g. <code>42</code>, <code>-3.14</code>, <code>1e5</code>). No NaN or Infinity.</li>
            <li><strong>Boolean:</strong> Lowercase <code>true</code> or <code>false</code>.</li>
            <li><strong>Null:</strong> Lowercase <code>null</code> to represent an empty or non-existent value.</li>
            <li><strong>Object:</strong> Unordered collection of zero or more comma-separated key/value pairs enclosed in braces (<code>&#123; "key": "value" &#125;</code>). Keys must be strings.</li>
            <li><strong>Array:</strong> Ordered list of zero or more values enclosed in square brackets (<code>[1, 2, 3]</code>).</li>
          </ul>
        </div>

        <div class="edu-card">
          <h3 class="edu-card-title">Top 4 JSON Syntax Pitfalls</h3>
          <ul class="edu-list">
            <li>
              <strong>1. Single Quotes vs Double Quotes:</strong><br />
              <span class="code-bad">Bad: &#123;'key': 'val'&#125;</span> → <span class="code-good">Good: &#123;"key": "val"&#125;</span><br />
              JSON syntax requires double quotes (<code>"</code>) for all strings and object keys.
            </li>
            <li>
              <strong>2. Trailing Commas:</strong><br />
              <span class="code-bad">Bad: [1, 2, 3,]</span> → <span class="code-good">Good: [1, 2, 3]</span><br />
              Standard JSON parsers reject commas before a closing bracket (<code>]</code>) or brace (<code>&#125;</code>).
            </li>
            <li>
              <strong>3. Unquoted Object Keys:</strong><br />
              <span class="code-bad">Bad: &#123; name: "Alice" &#125;</span> → <span class="code-good">Good: &#123; "name": "Alice" &#125;</span><br />
              Unlike JavaScript object literals, every JSON key must be explicitly double-quoted.
            </li>
            <li>
              <strong>4. Comments Are Not Permitted:</strong><br />
              <span class="code-bad">Bad: // Comment</span> → Standard JSON specifications contain no syntax for comments.
            </li>
          </ul>
        </div>
      </div>

      <!-- Cross-Links -->
      <footer class="related-links-bar">
        <div class="related-item">
          <span class="related-label">Learn Theory:</span>
          <a href="/guides/json-fundamentals/" class="related-link">
            JSON Fundamentals & AST Parsing Guide →
          </a>
        </div>
        <div class="related-item">
          <span class="related-label">Next Tool:</span>
          <a href="/tools/number-base-converter/" class="related-link">
            Number Base Converter (Binary, Octal, Hex) →
          </a>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  import {
    validateJson,
    formatJson,
    minifyJson,
    JSON_SAMPLE_PRESETS,
  } from '../../../core/tools/json-formatter';

  // Safe DOM Selection
  const jsonInput = document.getElementById('json-input') as HTMLTextAreaElement | null;
  const jsonOutput = document.getElementById('json-output') as HTMLTextAreaElement | null;
  const indentSelect = document.getElementById('indent-select') as HTMLSelectElement | null;
  const formatBtn = document.getElementById('format-btn');
  const validateBtn = document.getElementById('validate-btn');
  const minifyBtn = document.getElementById('minify-btn');
  const clearBtn = document.getElementById('clear-input-btn');
  const copyBtn = document.getElementById('copy-output-btn');
  const copyBtnText = document.getElementById('copy-btn-text');

  const inputStats = document.getElementById('input-stats');
  const outputStats = document.getElementById('output-stats');
  const statusCard = document.getElementById('status-card');
  const statusTitle = document.getElementById('status-title');
  const statusDesc = document.getElementById('status-desc');
  const statusIcon = document.getElementById('status-icon');
  const statusDetails = document.getElementById('status-details');
  const diagnosticBadge = document.getElementById('diagnostic-badge');
  const diagnosticSuggestion = document.getElementById('diagnostic-suggestion');
  const diagnosticSnippet = document.getElementById('diagnostic-snippet');

  const presetButtons = document.querySelectorAll<HTMLButtonElement>('[data-preset]');

  // Update input statistics on keyup/change
  function updateInputStats() {
    if (!jsonInput || !inputStats) return;
    const text = jsonInput.value;
    const charCount = text.length;
    const byteSize = new TextEncoder().encode(text).length;
    const lines = text ? text.split('\n').length : 0;
    inputStats.textContent = `${charCount} chars • ${byteSize} bytes • ${lines} lines`;
  }

  // Display status feedback with zero unsafe innerHTML
  function setStatus(
    type: 'success' | 'error' | 'neutral',
    title: string,
    desc: string,
    diagnostic?: {
      line: number;
      column: number;
      isExact: boolean;
      suggestion: string;
      snippet: string;
    }
  ) {
    if (!statusCard || !statusTitle || !statusDesc || !statusIcon) return;

    statusCard.className = `status-card status-${type}`;
    statusTitle.textContent = title;
    statusDesc.textContent = desc;
    statusIcon.textContent = type === 'success' ? 'OK' : type === 'error' ? 'ERR' : 'i';

    if (diagnostic && statusDetails && diagnosticBadge && diagnosticSuggestion && diagnosticSnippet) {
      statusDetails.style.display = 'block';
      diagnosticBadge.textContent = `${diagnostic.isExact ? 'Exact Location' : 'Estimated Location'}: Line ${diagnostic.line}, Column ${diagnostic.column}`;
      diagnosticSuggestion.textContent = diagnostic.suggestion;
      diagnosticSnippet.textContent = diagnostic.snippet;
    } else if (statusDetails) {
      statusDetails.style.display = 'none';
    }
  }

  // Action: Format JSON
  function handleFormat() {
    if (!jsonInput || !jsonOutput) return;
    const input = jsonInput.value;
    const indent = (indentSelect?.value === '4' ? 4 : 2) as 2 | 4;
    const result = formatJson(input, { indent });

    if (result.success) {
      jsonOutput.value = result.output;
      if (outputStats && result.stats) {
        outputStats.textContent = `${result.stats.characterCount} chars • ${result.stats.lineCount} lines (${result.stats.type})`;
      }
      setStatus(
        'success',
        'Valid JSON — Formatted Successfully',
        `Structured as a valid JSON ${result.stats?.type ?? 'data'}. Formatted with ${indent}-space indentation.`
      );
    } else {
      jsonOutput.value = '';
      if (outputStats) outputStats.textContent = 'Formatting failed';
      setStatus(
        'error',
        'Syntax Error Detected',
        result.error?.message ?? 'Invalid JSON syntax.',
        result.error
      );
    }
  }

  // Action: Validate JSON
  function handleValidate() {
    if (!jsonInput) return;
    const input = jsonInput.value;
    const result = validateJson(input);

    if (result.isValid) {
      if (outputStats && result.stats) {
        outputStats.textContent = `Valid (${result.stats.type})`;
      }
      setStatus(
        'success',
        'Valid JSON Syntax',
        `The JSON is formally valid according to RFC 8259 specifications (${result.stats?.type}, ${result.stats?.characterCount} characters).`
      );
    } else {
      if (outputStats) outputStats.textContent = 'Validation error';
      setStatus(
        'error',
        'Validation Failed',
        result.error?.message ?? 'Syntax error in JSON.',
        result.error
      );
    }
  }

  // Action: Minify JSON
  function handleMinify() {
    if (!jsonInput || !jsonOutput) return;
    const input = jsonInput.value;
    const result = minifyJson(input);

    if (result.success) {
      jsonOutput.value = result.output;
      if (outputStats && result.stats) {
        const reduction = result.stats.characterCount - result.output.length;
        const percent = result.stats.characterCount > 0 ? ((reduction / result.stats.characterCount) * 100).toFixed(1) : '0';
        outputStats.textContent = `Minified: -${percent}% (${result.output.length} chars)`;
      }
      setStatus(
        'success',
        'JSON Minified Successfully',
        'Stripped all redundant whitespace, indentation, and newlines for compact transmission.'
      );
    } else {
      jsonOutput.value = '';
      if (outputStats) outputStats.textContent = 'Minification failed';
      setStatus(
        'error',
        'Syntax Error Detected',
        result.error?.message ?? 'Cannot minify invalid JSON.',
        result.error
      );
    }
  }

  // Action: Clear Input
  function handleClear() {
    if (jsonInput) jsonInput.value = '';
    if (jsonOutput) jsonOutput.value = '';
    if (outputStats) outputStats.textContent = 'Ready';
    updateInputStats();
    setStatus('neutral', 'Status: Ready', 'Input cleared. Paste new JSON or choose a preset.');
  }

  // Action: Copy Output
  async function handleCopy() {
    if (!jsonOutput || !jsonOutput.value) return;
    try {
      await navigator.clipboard.writeText(jsonOutput.value);
      if (copyBtnText) copyBtnText.textContent = 'Copied';
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copy Output';
      }, 2000);
    } catch {
      jsonOutput.select();
      document.execCommand('copy');
      if (copyBtnText) copyBtnText.textContent = 'Copied';
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copy Output';
      }, 2000);
    }
  }

  // Preset Buttons
  presetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const presetKey = btn.dataset.preset as keyof typeof JSON_SAMPLE_PRESETS | 'invalid';
      if (!jsonInput) return;

      if (presetKey === 'invalid') {
        jsonInput.value = JSON_SAMPLE_PRESETS.invalidSample;
      } else if (presetKey in JSON_SAMPLE_PRESETS) {
        jsonInput.value = JSON_SAMPLE_PRESETS[presetKey as 'simple' | 'nested' | 'unicode'];
      }
      updateInputStats();
      handleFormat();
    });
  });

  // Event Listeners
  jsonInput?.addEventListener('input', updateInputStats);
  formatBtn?.addEventListener('click', handleFormat);
  validateBtn?.addEventListener('click', handleValidate);
  minifyBtn?.addEventListener('click', handleMinify);
  clearBtn?.addEventListener('click', handleClear);
  copyBtn?.addEventListener('click', handleCopy);
  indentSelect?.addEventListener('change', () => {
    if (jsonOutput?.value) handleFormat();
  });

  // Initial population with default clean preset
  if (jsonInput && !jsonInput.value) {
    jsonInput.value = JSON_SAMPLE_PRESETS.simple;
    updateInputStats();
    handleFormat();
  }
</script>

<style>
  .tool-page-container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  /* Breadcrumbs */
  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .breadcrumb-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary-400);
  }
  .separator {
    color: var(--color-border);
  }

  /* Header */
  .tool-header {
    margin-bottom: var(--space-8);
  }
  .header-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .category-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary-400);
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-emerald-400);
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .tool-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  .tool-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 780px;
    line-height: var(--leading-relaxed);
  }

  /* Toolbar */
  .toolbar-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }
  .presets-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .toolbar-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .preset-btn {
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    min-height: 32px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .preset-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-primary-500);
    background-color: rgba(99, 102, 241, 0.08);
  }
  .warning-preset {
    color: var(--color-amber-400);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .warning-preset:hover {
    background-color: rgba(245, 158, 11, 0.1);
    border-color: var(--color-amber-400);
  }

  .indent-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .indent-select {
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-primary);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    min-height: 32px;
    cursor: pointer;
  }

  /* Editor Grid */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
  @media (min-width: 900px) {
    .editor-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .editor-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .editor-col-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
  }
  .col-title-group {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .col-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }
  .col-stats {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .action-btn-sm {
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-slate-800);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    min-height: 44px; /* Accessible 44px touch target (resolving RISK-002) */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .action-btn-sm:hover {
    color: var(--color-cyan-400);
    border-color: var(--color-cyan-400);
    background-color: rgba(76, 215, 246, 0.08);
  }

  .textarea-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
  }
  .textarea-wrapper:focus-within {
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
  }
  .code-textarea {
    width: 100%;
    min-height: 360px;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
    background-color: transparent;
    border: none;
    outline: none;
    resize: vertical;
    white-space: pre;
    tab-size: 2;
  }

  /* Action Buttons */
  .input-actions-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .btn-primary, .btn-secondary {
