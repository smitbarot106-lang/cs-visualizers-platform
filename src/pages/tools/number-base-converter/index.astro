---
// ============================================================================
// Number Base Converter (Route: /tools/number-base-converter/)
// Synchronized Binary, Octal, Decimal & Hexadecimal converter with step-by-step math
// ============================================================================

import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Number Base Converter — Binary, Octal, Decimal, Hexadecimal"
  description="Convert between Binary (Base 2), Octal (Base 8), Decimal (Base 10), and Hexadecimal (Base 16) with repeated division math and positional weight tables."
  currentRoute="/tools/number-base-converter/"
>
  <div class="tool-page-container container">
    <!-- 1. Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li><a href="/tools/">Developer Tools</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li aria-current="page">Number Base Converter</li>
      </ol>
    </nav>

    <!-- 2. Tool Heading & Privacy Declaration -->
    <header class="tool-header">
      <div class="header-badge-row">
        <span class="category-badge">RADIX ARITHMETIC</span>
        <span class="privacy-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          100% Local BigInt Precision
        </span>
      </div>
      <h1 class="tool-title">Number Base Converter</h1>
      <p class="tool-lead">
        Synchronized conversion between Binary, Octal, Decimal, and Hexadecimal. 
        Powered by arbitrary-precision <code>BigInt</code> arithmetic with step-by-step division and positional-weight proofs.
      </p>
    </header>

    <!-- 3. Presets & Controls Toolbar -->
    <section class="toolbar-section" aria-label="Tool Presets and Controls">
      <div class="presets-group">
        <span class="toolbar-label">Quick Presets:</span>
        <button type="button" class="preset-btn" data-preset="42">42 (Decimal)</button>
        <button type="button" class="preset-btn" data-preset="255">255 (Byte 0xFF)</button>
        <button type="button" class="preset-btn" data-preset="1024">1024 (Kibi)</button>
        <button type="button" class="preset-btn" data-preset="deadbeef">0xDEADBEEF</button>
        <button type="button" class="preset-btn" data-preset="bin1101">11010101 (Bin)</button>
        <button type="button" class="preset-btn" data-preset="bigint">64-Bit Max</button>
      </div>

      <button type="button" id="reset-all-btn" class="reset-btn" aria-label="Reset all base inputs">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
        <span>Reset All</span>
      </button>
    </section>

    <!-- 4. Synchronized Multi-Base Inputs Grid -->
    <main class="converter-grid" aria-label="Synchronized Base Converter Fields">
      <!-- Decimal Card -->
      <article class="base-card" data-base="10">
        <div class="card-header">
          <div class="header-left">
            <span class="radix-pill">Base 10</span>
            <h2 class="base-name">Decimal</h2>
          </div>
          <span class="allowed-chars">Digits: 0–9</span>
        </div>
        <div class="input-wrapper">
          <input
            type="text"
            id="input-dec"
            class="base-input"
            placeholder="e.g. 42"
            value="42"
            spellcheck="false"
            autocomplete="off"
            aria-label="Decimal value (Base 10)"
          />
          <button type="button" class="copy-field-btn" data-target="input-dec" aria-label="Copy Decimal value">
            Copy
          </button>
        </div>
        <div class="field-meta">
          <span id="meta-dec" class="meta-text" aria-live="polite">Magnitude: 2 digits</span>
        </div>
      </article>

      <!-- Binary Card -->
      <article class="base-card" data-base="2">
        <div class="card-header">
          <div class="header-left">
            <span class="radix-pill">Base 2</span>
            <h2 class="base-name">Binary</h2>
          </div>
          <span class="allowed-chars">Digits: 0, 1</span>
        </div>
        <div class="input-wrapper">
          <input
            type="text"
            id="input-bin"
            class="base-input font-mono"
            placeholder="e.g. 101010"
            spellcheck="false"
            autocomplete="off"
            aria-label="Binary value (Base 2)"
          />
          <button type="button" class="copy-field-btn" data-target="input-bin" aria-label="Copy Binary value">
            Copy
          </button>
        </div>
        <div class="field-meta">
          <span id="meta-bin" class="meta-text" aria-live="polite">Bits: 6 • Bytes: 1</span>
        </div>
      </article>

      <!-- Hexadecimal Card -->
      <article class="base-card" data-base="16">
        <div class="card-header">
          <div class="header-left">
            <span class="radix-pill">Base 16</span>
            <h2 class="base-name">Hexadecimal</h2>
          </div>
          <span class="allowed-chars">Digits: 0–9, A–F</span>
        </div>
        <div class="input-wrapper">
          <input
            type="text"
            id="input-hex"
            class="base-input font-mono"
            placeholder="e.g. 2A"
            spellcheck="false"
            autocomplete="off"
            aria-label="Hexadecimal value (Base 16)"
          />
          <button type="button" class="copy-field-btn" data-target="input-hex" aria-label="Copy Hexadecimal value">
            Copy
          </button>
        </div>
        <div class="field-meta">
          <span id="meta-hex" class="meta-text" aria-live="polite">Nibbles: 2</span>
        </div>
      </article>

      <!-- Octal Card -->
      <article class="base-card" data-base="8">
        <div class="card-header">
          <div class="header-left">
            <span class="radix-pill">Base 8</span>
            <h2 class="base-name">Octal</h2>
          </div>
          <span class="allowed-chars">Digits: 0–7</span>
        </div>
        <div class="input-wrapper">
          <input
            type="text"
            id="input-oct"
            class="base-input font-mono"
            placeholder="e.g. 52"
            spellcheck="false"
            autocomplete="off"
            aria-label="Octal value (Base 8)"
          />
          <button type="button" class="copy-field-btn" data-target="input-oct" aria-label="Copy Octal value">
            Copy
          </button>
        </div>
        <div class="field-meta">
          <span id="meta-oct" class="meta-text" aria-live="polite">Octal digits: 2</span>
        </div>
      </article>
    </main>

    <!-- Error / Validation Banner -->
    <div id="error-banner" class="error-banner" role="alert" aria-live="polite" style="display: none;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="error-message-text">Invalid character entered.</span>
    </div>

    <!-- 5. Step-by-Step Educational Explanation Card -->
    <section class="explanation-section" aria-label="Step-by-Step Mathematical Explanation">
      <div class="explanation-header">
        <div class="explanation-title-group">
          <span class="edu-pill">MATHEMATICAL PROOF</span>
          <h2 class="explanation-title">Step-by-Step Calculation</h2>
        </div>
        <div class="explanation-selector">
          <label for="explanation-mode" class="selector-label">Explain Conversion To:</label>
          <select id="explanation-mode" class="mode-select" aria-label="Select explanation target">
            <option value="2">Decimal → Binary (Repeated Division by 2)</option>
            <option value="16">Decimal → Hexadecimal (Repeated Division by 16)</option>
            <option value="8">Decimal → Octal (Repeated Division by 8)</option>
            <option value="10">Binary → Decimal (Positional Weight Powers)</option>
          </select>
        </div>
      </div>

      <!-- Dynamic Explanation Container -->
      <div id="explanation-content" class="explanation-content">
        <!-- Division Table View -->
        <div id="division-view" class="division-view">
          <p class="division-instruction">
            <strong>Repeated Division Algorithm:</strong> Divide the decimal number continuously by the target base radix. 
            Record the integer quotient and remainder at each step until the quotient reaches <code>0</code>. 
            Then, read the remainders from <strong>bottom to top</strong>.
          </p>

          <div class="table-scroll-wrapper">
            <table class="math-table" aria-label="Repeated division step table">
              <thead>
                <tr>
                  <th scope="col">Step</th>
                  <th scope="col">Division Operation</th>
                  <th scope="col">Quotient</th>
                  <th scope="col">Remainder</th>
                  <th scope="col">Hex Digit</th>
                </tr>
              </thead>
              <tbody id="division-table-body">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>

          <div class="result-reading-box">
            <span class="reading-arrow">↑</span>
            <div>
              <strong>Read remainders from bottom to top:</strong>
              <div id="division-result-string" class="result-mono">101010</div>
            </div>
          </div>
        </div>

        <!-- Positional Expansion View -->
        <div id="positional-view" class="positional-view" style="display: none;">
          <p class="positional-instruction">
            <strong>Positional Weight Expansion:</strong> Each digit's value is determined by multiplying the digit 
            by the radix raised to its power of position (counting from position 0 on the far right).
          </p>

          <div class="table-scroll-wrapper">
            <table class="math-table" aria-label="Positional weight table">
              <thead>
                <tr>
                  <th scope="col">Digit</th>
                  <th scope="col">Position ($k$)</th>
                  <th scope="col">Weight ($2^k$)</th>
                  <th scope="col">Value ($d \times 2^k$)</th>
                </tr>
              </thead>
              <tbody id="positional-table-body">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>

          <div class="expansion-formula-box">
            <span class="formula-label">Sum of Terms:</span>
            <p id="positional-formula-text" class="formula-text"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Educational Guide Section -->
    <article class="educational-section">
      <header class="edu-header">
        <span class="edu-badge">COMPUTER ARCHITECTURE ESSENTIALS</span>
        <h2 class="edu-title">Why Do Computers Use Multiple Number Bases?</h2>
        <p class="edu-lead">
          While humans use Decimal (Base 10) due to ten fingers, electronic digital circuits operate exclusively on two physical electrical states: 
          high voltage and low voltage (Binary, Base 2). Octal and Hexadecimal exist as compact human shorthands for long binary strings.
        </p>
      </header>

      <div class="edu-grid">
        <div class="edu-card">
          <h3 class="edu-card-title">Base Power-of-Two Equivalence</h3>
          <ul class="edu-list">
            <li><strong>Binary (Base 2):</strong> The fundamental physics of logic gates. Each digit represents exactly $2^1 = 2$ states (1 bit).</li>
            <li><strong>Octal (Base 8):</strong> Grouping bits in sets of 3 ($2^3 = 8$). Often used in UNIX file permission flags (e.g. <code>chmod 755</code>).</li>
            <li><strong>Hexadecimal (Base 16):</strong> Grouping bits in sets of 4 ($2^4 = 16$). One byte (8 bits) is represented by exactly 2 hex characters (e.g. <code>1111 1111₂ = FF₁₆</code>).</li>
            <li><strong>Decimal (Base 10):</strong> The standard positional system used in everyday human communication.</li>
          </ul>
        </div>

        <div class="edu-card">
          <h3 class="edu-card-title">Handling Large Integers & Negative Numbers</h3>
          <ul class="edu-list">
            <li>
              <strong>Arbitrary Precision BigInt:</strong> Standard JavaScript numbers lose precision beyond $2^{53} - 1$ ($9,007,199,254,740,991$). 
              This tool utilizes ES2020 <code>BigInt</code> to support 64-bit, 128-bit, and arbitrary magnitude integers without truncation.
            </li>
            <li>
              <strong>Negative Numbers:</strong> Represented with mathematical sign magnitude. 
              In CPU registers, negative numbers are stored as <em>Two's Complement</em>, flipping bits and adding 1.
            </li>
          </ul>
        </div>
      </div>

      <!-- Cross-Links -->
      <footer class="related-links-bar">
        <div class="related-item">
          <span class="related-label">Learn Theory:</span>
          <a href="/guides/number-systems/" class="related-link">
            Number Systems & Radix Arithmetic Guide →
          </a>
        </div>
        <div class="related-item">
          <span class="related-label">Companion Tool:</span>
          <a href="/tools/json-formatter/" class="related-link">
            JSON Formatter & Validator →
          </a>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  import {
    convertAllBases,
    generateDivisionSteps,
    generatePositionalTerms,
    type NumberBase,
  } from '../../../core/tools/base-converter';

  // DOM Elements
  const inputDec = document.getElementById('input-dec') as HTMLInputElement | null;
  const inputBin = document.getElementById('input-bin') as HTMLInputElement | null;
  const inputHex = document.getElementById('input-hex') as HTMLInputElement | null;
  const inputOct = document.getElementById('input-oct') as HTMLInputElement | null;

  const metaDec = document.getElementById('meta-dec');
  const metaBin = document.getElementById('meta-bin');
  const metaHex = document.getElementById('meta-hex');
  const metaOct = document.getElementById('meta-oct');

  const errorBanner = document.getElementById('error-banner');
  const errorMessageText = document.getElementById('error-message-text');

  const explanationMode = document.getElementById('explanation-mode') as HTMLSelectElement | null;
  const divisionView = document.getElementById('division-view');
  const positionalView = document.getElementById('positional-view');
  const divisionTableBody = document.getElementById('division-table-body');
  const divisionResultString = document.getElementById('division-result-string');
  const positionalTableBody = document.getElementById('positional-table-body');
  const positionalFormulaText = document.getElementById('positional-formula-text');

  const resetBtn = document.getElementById('reset-all-btn');
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-field-btn');
  const presetButtons = document.querySelectorAll<HTMLButtonElement>('[data-preset]');

  // Clear all error states
  function clearError() {
    if (errorBanner) errorBanner.style.display = 'none';
  }

  // Display validation error banner
  function showError(msg: string) {
    if (errorBanner && errorMessageText) {
      errorMessageText.textContent = msg;
      errorBanner.style.display = 'flex';
    }
  }

  // Sync inputs based on changes to source base
  function synchronize(sourceBase: NumberBase) {
    clearError();

    let sourceValue = '';
    if (sourceBase === 10) sourceValue = inputDec?.value ?? '';
    else if (sourceBase === 2) sourceValue = inputBin?.value ?? '';
    else if (sourceBase === 16) sourceValue = inputHex?.value ?? '';
    else if (sourceBase === 8) sourceValue = inputOct?.value ?? '';

    if (!sourceValue.trim()) {
      if (sourceBase !== 10 && inputDec) inputDec.value = '';
      if (sourceBase !== 2 && inputBin) inputBin.value = '';
      if (sourceBase !== 16 && inputHex) inputHex.value = '';
      if (sourceBase !== 8 && inputOct) inputOct.value = '';
      if (metaDec) metaDec.textContent = 'Empty';
      if (metaBin) metaBin.textContent = 'Empty';
      if (metaHex) metaHex.textContent = 'Empty';
      if (metaOct) metaOct.textContent = 'Empty';
      renderExplanation();
      return;
    }

    const conv = convertAllBases(sourceValue, sourceBase);
    if (!conv.success || !conv.result) {
      showError(conv.errorMessage ?? 'Invalid number input.');
      return;
    }

    const res = conv.result;

    if (sourceBase !== 10 && inputDec) inputDec.value = res.decimal;
    if (sourceBase !== 2 && inputBin) inputBin.value = res.binary;
    if (sourceBase !== 16 && inputHex) inputHex.value = res.hexadecimal;
    if (sourceBase !== 8 && inputOct) inputOct.value = res.octal;

    // Update Metadata Counters
    if (metaDec) metaDec.textContent = `Magnitude: ${res.decimal.length} digits`;
    if (metaBin) metaBin.textContent = `Bits: ${res.bitLength} • Bytes: ${res.byteLength}`;
    if (metaHex) metaHex.textContent = `Nibbles: ${Math.ceil(res.bitLength / 4)}`;
    if (metaOct) metaOct.textContent = `Octal digits: ${res.octal.length}`;

    renderExplanation();
  }

  // Render the educational explanation
  function renderExplanation() {
    const decValStr = inputDec?.value.trim() ?? '';
    const binValStr = inputBin?.value.trim() ?? '';
    const mode = explanationMode?.value ?? '2';

    if (!decValStr) {
      if (divisionTableBody) divisionTableBody.innerHTML = '';
      if (divisionResultString) divisionResultString.textContent = '—';
      if (positionalTableBody) positionalTableBody.innerHTML = '';
      if (positionalFormulaText) positionalFormulaText.textContent = '—';
      return;
    }

    try {
      const isNeg = decValStr.startsWith('-');
      const absDecStr = isNeg ? decValStr.slice(1) : decValStr;
      const absBig = BigInt(absDecStr || '0');

      if (mode === '10') {
        // Positional Expansion Mode (Binary -> Decimal)
        if (divisionView) divisionView.style.display = 'none';
        if (positionalView) positionalView.style.display = 'block';

        const terms = generatePositionalTerms(binValStr.replace(/^-/, ''), 2);
        if (positionalTableBody) {
          positionalTableBody.innerHTML = '';
          terms.forEach(term => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><code>${term.digit}</code></td>
              <td>${term.position}</td>
              <td><code>${term.power}</code> = ${BigInt(2) ** BigInt(term.position)}</td>
              <td><code>${term.termProduct}</code></td>
            `;
            positionalTableBody.appendChild(tr);
          });
        }

        if (positionalFormulaText) {
          const formula = terms.map(t => `${t.decimalValue}×2^${t.position}`).join(' + ') + ` = ${absBig.toString()}`;
          positionalFormulaText.textContent = formula;
        }
      } else {
        // Repeated Division Mode (Decimal -> Binary, Hex, Octal)
        if (positionalView) positionalView.style.display = 'none';
        if (divisionView) divisionView.style.display = 'block';

        const targetRadix = parseInt(mode, 10) as 2 | 8 | 16;
        const steps = generateDivisionSteps(absBig, targetRadix);

        if (divisionTableBody) {
          divisionTableBody.innerHTML = '';
          steps.forEach(step => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${step.stepNumber}</td>
              <td><code>${step.dividend} ÷ ${step.divisor}</code></td>
              <td><code>${step.quotient}</code></td>
              <td><strong class="highlight-remainder">${step.remainder}</strong></td>
              <td>${step.remainderHex !== undefined ? `<code>${step.remainderHex}</code>` : '—'}</td>
            `;
            divisionTableBody.appendChild(tr);
          });
        }

        if (divisionResultString) {
          const resultChars = steps.map(s => (s.remainderHex !== undefined ? s.remainderHex : String(s.remainder))).reverse().join('');
          divisionResultString.textContent = (isNeg ? '-' : '') + (resultChars || '0');
        }
      }
    } catch {
      // Ignored during user typing
    }
  }

  // Copy Buttons
  copyButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const targetInput = document.getElementById(targetId) as HTMLInputElement | null;
      if (!targetInput || !targetInput.value) return;

      try {
        await navigator.clipboard.writeText(targetInput.value);
        const originalText = btn.textContent;
        btn.textContent = 'Copied! ✔';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 1800);
      } catch {
        targetInput.select();
        document.execCommand('copy');
        const originalText = btn.textContent;
        btn.textContent = 'Copied! ✔';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 1800);
      }
    });
  });

  // Reset Button
  resetBtn?.addEventListener('click', () => {
    if (inputDec) inputDec.value = '';
    if (inputBin) inputBin.value = '';
    if (inputHex) inputHex.value = '';
    if (inputOct) inputOct.value = '';
    clearError();
    synchronize(10);
  });

  // Preset Buttons
  presetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      if (!inputDec || !inputBin || !inputHex || !inputOct) return;

      if (preset === '42') {
        inputDec.value = '42';
        synchronize(10);
      } else if (preset === '255') {
        inputDec.value = '255';
        synchronize(10);
      } else if (preset === '1024') {
        inputDec.value = '1024';
        synchronize(10);
      } else if (preset === 'deadbeef') {
        inputHex.value = 'DEADBEEF';
        synchronize(16);
      } else if (preset === 'bin1101') {
        inputBin.value = '11010101';
        synchronize(2);
      } else if (preset === 'bigint') {
        inputDec.value = '18446744073709551615';
        synchronize(10);
      }
    });
  });

  // Event Listeners for real-time synchronization
  inputDec?.addEventListener('input', () => synchronize(10));
  inputBin?.addEventListener('input', () => synchronize(2));
  inputHex?.addEventListener('input', () => synchronize(16));
  inputOct?.addEventListener('input', () => synchronize(8));
  explanationMode?.addEventListener('change', () => renderExplanation());

  // Initial Sync with default Decimal 42
  synchronize(10);
</script>

<style>
  .tool-page-container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  /* Breadcrumbs */
  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .breadcrumb-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary-400);
  }
  .separator {
    color: var(--color-border);
  }

  /* Header */
  .tool-header {
    margin-bottom: var(--space-8);
  }
  .header-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .category-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary-400);
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-emerald-400);
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  .tool-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  .tool-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 800px;
    line-height: var(--leading-relaxed);
  }

  /* Toolbar */
  .toolbar-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
