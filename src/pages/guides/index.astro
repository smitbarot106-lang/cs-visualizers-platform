---
// ============================================================================
// CS Guides & Big-O Reference (Route: /guides/)
// Refined Dark Theme — High readability, distinct domain cards, and zero eye-strain
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';

const FEATURED_GUIDE = {
  title: 'Big-O Complexity Cheat Sheet',
  category: 'COMPLEXITY THEORY',
  badge: 'CORE REFERENCE',
  readTime: '6 min read',
  formula: 'O(1) < O(log n) < O(n) < O(n log n) < O(n²)',
  description:
    'Comprehensive asymptotic growth reference connecting theoretical time and space complexity curves directly to our interactive algorithm visualizers.',
  tags: ['Asymptotic Growth', 'Time & Space Bounds', 'Best/Average/Worst', 'Search vs Sort'],
  href: '/guides/big-o-cheat-sheet/',
};

const TOPIC_GUIDES = [
  {
    title: 'JSON Fundamentals: Syntax, Types & Parsing',
    category: 'DATA FORMATS',
    theme: 'emerald',
    readTime: '7 min read',
    companionTool: 'JSON Formatter & Validator',
    companionHref: '/tools/json-formatter/',
    description:
      'Understand the formal structure of JSON (RFC 8259), lexical tokenization, AST generation, and how to debug the 7 most common syntax errors.',
    tags: ['RFC 8259 Grammar', 'AST Tokenization', 'Syntax Diagnostics', 'In-Browser Tool'],
    href: '/guides/json-fundamentals/',
  },
  {
    title: 'Number Systems: Binary, Octal, Decimal & Hexadecimal',
    category: 'RADIX ARITHMETIC',
    theme: 'amber',
    readTime: '9 min read',
    companionTool: 'Number Base Converter',
    companionHref: '/tools/number-base-converter/',
    description:
      'Demystifying positional number systems in computer architecture, repeated division algorithms, power-of-two nibble groupings, and BigInt precision limits.',
    tags: ['Repeated Division', 'Positional Weights', 'Nibble Grouping', 'Two’s Complement'],
    href: '/guides/number-systems/',
  },
  {
    title: 'Understanding Binary Search & O(log n) Efficiency',
    category: 'SEARCH ALGORITHMS',
    theme: 'cyan',
    readTime: '8 min read',
    companionTool: 'Binary Search Visualizer',
    companionHref: '/visualizers/binary-search/',
    description:
      'A deep dive into divide-and-conquer searching, loop invariants, pointer mechanics (Low, Mid, High), and why logarithmic scaling handles billions of elements.',
    tags: ['Divide & Conquer', 'Pointer Tracking', 'Overflow Prevention', 'O(log n) Proof'],
    href: '/guides/binary-search/',
  },
  {
    title: 'Comparison Sorting Demystified: Bubble, Selection & Insertion',
    category: 'SORTING ALGORITHMS',
    theme: 'indigo',
    readTime: '10 min read',
    companionTool: 'Sorting Visualizer',
    companionHref: '/visualizers/sorting/',
    description:
      'Explore elementary comparison sorting mechanics, adjacent swaps, sorted sub-array invariants, and algorithmic stability trade-offs.',
    tags: ['Bubble Sort', 'Selection Sort', 'Insertion Sort', 'Swap vs Shift'],
    href: '/guides/sorting-algorithms/',
  },
  {
    title: 'Graph Traversal Foundations: When to Use BFS vs DFS',
    category: 'GRAPH THEORY',
    theme: 'purple',
    readTime: '11 min read',
    companionTool: 'BFS & DFS Visualizer',
    companionHref: '/visualizers/bfs-dfs/',
    description:
      'Master fundamental graph exploration paradigms: level-order shortest paths using FIFO queues versus deep branch exploration using LIFO stacks and recursion.',
    tags: ['Breadth-First (Queue)', 'Depth-First (Stack)', 'Visited Sets', 'Cycle Detection'],
    href: '/guides/bfs-dfs/',
  },
];
---

<BaseLayout
  title="Computer Science Guides & Big-O Reference"
  description="Beginner-friendly computer science guides and Big-O complexity reference linking theory directly to interactive tools."
  currentRoute="/guides/"
>
  <div class="guides-directory container">
    <!-- Header Zone -->
    <header class="directory-header">
      <div class="header-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>CS EDUCATIONAL ARCHIVE • PEER-REVIEWED TOPICS</span>
      </div>
      <h1 class="directory-title">Computer Science Guides & Cheat Sheets</h1>
      <p class="directory-lead">
        Original, plain-English educational guides designed to bridge theoretical computer science concepts with hands-on interactive tools and visualizers.
      </p>
    </header>

    <!-- 1. Featured Guide: Big-O Complexity Hero Card -->
    <section class="featured-section" aria-label="Featured Complexity Reference">
      <div class="featured-card">
        <div class="featured-card-header">
          <div class="featured-meta">
            <span class="theme-tag indigo">{FEATURED_GUIDE.category}</span>
            <span class="pill-badge">{FEATURED_GUIDE.badge}</span>
            <span class="time-badge">{FEATURED_GUIDE.readTime}</span>
          </div>
          <span class="formula-pill" aria-label="Complexity ordering">
            <code>{FEATURED_GUIDE.formula}</code>
          </span>
        </div>

        <div class="featured-body">
          <h2 class="featured-title">
            <a href={FEATURED_GUIDE.href}>{FEATURED_GUIDE.title}</a>
          </h2>
          <p class="featured-desc">{FEATURED_GUIDE.description}</p>

          <div class="tags-row" aria-label="Key concepts covered">
            {FEATURED_GUIDE.tags.map(tag => (
              <span class="concept-tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="featured-footer">
          <a href={FEATURED_GUIDE.href} class="btn-explore-hero">
            <span>Explore Big-O Cheat Sheet</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Topic Guides Grid -->
    <section class="topics-section" aria-label="Topic Guides Archive">
      <div class="section-subhead">
        <h2 class="subhead-title">Fundamental CS Topic Guides</h2>
        <span class="subhead-count">{TOPIC_GUIDES.length} Curated Guides</span>
      </div>

      <div class="guides-grid">
        {TOPIC_GUIDES.map(guide => (
          <article class="topic-card">
            <div class="card-top-row">
              <span class={`theme-tag ${guide.theme}`}>{guide.category}</span>
              <span class="time-badge">{guide.readTime}</span>
            </div>

            <h3 class="card-title">
              <a href={guide.href}>{guide.title}</a>
            </h3>

            <p class="card-desc">{guide.description}</p>

            <div class="tags-row" aria-label="Key concepts">
              {guide.tags.map(tag => (
                <span class="concept-tag">{tag}</span>
              ))}
            </div>

            <div class="card-footer">
              <a href={guide.companionHref} class="companion-pill" title={`Interactive companion: ${guide.companionTool}`}>
                <span class="companion-dot" aria-hidden="true"></span>
                <span>{guide.companionTool}</span>
              </a>

              <a href={guide.href} class="read-link" aria-label={`Read ${guide.title}`}>
                <span>Read Guide</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guides-directory {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  /* Header */
  .directory-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--space-10);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    background-color: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-indigo-400);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-indigo-400);
    border-radius: 50%;
  }

  .directory-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
  }

  .directory-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Featured Hero Card */
  .featured-section {
    margin-bottom: var(--space-12);
  }

  .featured-card {
    background: linear-gradient(135deg, rgba(19, 24, 41, 0.95) 0%, rgba(25, 33, 56, 0.8) 100%);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .featured-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    box-shadow: var(--shadow-glow);
  }

  .featured-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .formula-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-emerald-400);
    background-color: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
  }

  .featured-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .featured-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .featured-title a:hover {
    color: var(--color-indigo-400);
  }

  .featured-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 900px;
    margin-bottom: var(--space-5);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .concept-tag {
    font-size: var(--text-xs);
    color: var(--color-slate-300);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
  }

  .btn-explore-hero {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-text);
    background-color: var(--color-indigo-600);
    border: 1px solid var(--color-indigo-500);
    border-radius: var(--radius-md);
    padding: 0 var(--space-5);
    min-height: 44px; /* Accessible 44px touch target */
    transition: all var(--transition-fast);
  }

  .btn-explore-hero:hover {
    background-color: var(--color-indigo-500);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  /* Section Subhead */
  .section-subhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .subhead-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .subhead-count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  /* Topics Grid */
  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .guides-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .topic-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  /* Theme Badges */
  .theme-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .theme-tag.emerald {
    color: var(--color-emerald-400);
    background-color: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .theme-tag.amber {
    color: var(--color-amber-400);
    background-color: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .theme-tag.cyan {
    color: var(--color-cyan-400);
    background-color: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .theme-tag.indigo {
    color: var(--color-indigo-400);
    background-color: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .theme-tag.purple {
    color: var(--color-purple-400);
    background-color: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .pill-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-slate-300);
    background-color: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .time-badge {
    font-size: var(--text-xs);
    color: var(--color-slate-500);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--color-indigo-400);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    flex: 1;
  }

  /* Card Footer */
  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: auto;
  }

  .companion-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--color-slate-400);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .companion-pill:hover {
    color: var(--color-text-primary);
    border-color: var(--color-indigo-400);
  }

  .companion-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-emerald-400);
    border-radius: 50%;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-indigo-400);
    min-height: 28px;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .read-link:hover {
    color: #ffffff;
    gap: 7px;
  }
</style>
