---
// ============================================================================
// Platform Homepage (Route: /)
// ============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';

const FEATURED_VISUALIZERS = [
  {
    title: 'Binary Search Visualizer',
    description: 'Track Low, Mid, and High pointers step-by-step with synchronized pseudocode and plain-English narration.',
    href: '/visualizers/binary-search/',
    badge: 'Search',
    color: 'indigo',
  },
  {
    title: 'Sorting Visualizer',
    description: 'Observe Bubble Sort, Selection Sort, and Insertion Sort with comparison and swap counters.',
    href: '/visualizers/sorting/',
    badge: 'Sorting',
    color: 'emerald',
  },
  {
    title: 'BFS & DFS Graph Visualizer',
    description: 'Inspect Queue and Stack operations with visited-node tracking across structured preset graphs.',
    href: '/visualizers/bfs-dfs/',
    badge: 'Graphs & Trees',
    color: 'cyan',
  },
];

const FEATURED_TOOLS = [
  {
    title: 'JSON Formatter & Validator',
    description: 'Format, validate, and minify JSON with beginner-friendly line/column syntax error explanations.',
    href: '/tools/json-formatter/',
    badge: 'Developer Tool',
  },
  {
    title: 'Number Base Converter',
    description: 'Convert between Binary, Decimal, Octal, and Hexadecimal with step-by-step division and place-value math.',
    href: '/tools/number-base-converter/',
    badge: 'Radix Conversion',
  },
];
---

<BaseLayout
  title="Interactive CS Visualizers & Privacy-First DevTools"
  description="Don't just see the answer — understand how it works. Interactive algorithm visualizers, pointer tracking, and privacy-first developer tools."
  currentRoute="/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Open Educational Platform • 100% Client-Side Privacy</span>
      </div>

      <h1 class="hero-title">
        Don’t just see the answer — <br />
        <span class="gradient-text">understand how it works.</span>
      </h1>

      <p class="hero-lead">
        Step-by-step interactive visualizers for core computer science algorithms and everyday developer tools. 
        Featuring reversible stepping, variable watch, synchronized pseudocode, and zero tracking.
      </p>

      <div class="hero-actions">
        <a href="/visualizers/binary-search/" class="btn-primary">
          <span>Try Binary Search</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/tools/json-formatter/" class="btn-secondary">
          <span>JSON Formatter</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Visualizers Grid -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Core Algorithm Visualizers</h2>
        <p class="section-desc">Interactive step engines designed for CS students and interview preparation.</p>
      </div>

      <div class="cards-grid">
        {FEATURED_VISUALIZERS.map(v => (
          <a href={v.href} class="feature-card">
            <div class="card-top">
              <span class={`card-badge ${v.color}`}>{v.badge}</span>
            </div>
            <h3 class="card-title">{v.title}</h3>
            <p class="card-desc">{v.description}</p>
            <div class="card-link-row">
              <span>Launch Visualizer</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Developer Tools Section -->
  <section class="tools-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Privacy-First Developer Tools</h2>
        <p class="section-desc">Practical utilities that explain errors in plain English instead of cryptic stack traces.</p>
      </div>

      <div class="tools-grid">
        {FEATURED_TOOLS.map(t => (
          <a href={t.href} class="tool-card">
            <div class="card-top">
              <span class="card-badge slate">{t.badge}</span>
            </div>
            <h3 class="card-title">{t.title}</h3>
            <p class="card-desc">{t.description}</p>
            <div class="card-link-row">
              <span>Open Tool</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Educational & Privacy Principles -->
  <section class="trust-section">
    <div class="container">
      <div class="trust-box">
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">⏪</div>
          <h3 class="trust-title">Fully Reversible</h3>
          <p class="trust-desc">Step forward and backward. Precomputed immutable state snapshots eliminate playback bugs.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">🛡️</div>
          <h3 class="trust-title">Zero Data Transmission</h3>
          <p class="trust-desc">All algorithms, conversions, and JSON parsing execute strictly inside your local browser.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">♿</div>
          <h3 class="trust-title">Accessible & Clean</h3>
          <p class="trust-desc">Built with keyboard shortcuts, screen-reader narration (aria-live), and WCAG 2.2 AA standards.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 860px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--color-emerald-400);
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(32px, 5.5vw, 54px);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .gradient-text {
    background: linear-gradient(135deg, #818CF8 0%, #38BDF8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero-actions {
      flex-direction: row;
      justify-content: center;
      width: auto;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 48px;
    padding: 0 var(--space-6);
    background-color: var(--color-indigo-600);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .btn-primary:hover {
    background-color: var(--color-indigo-500);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 48px;
    padding: 0 var(--space-6);
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--color-indigo-500);
    background-color: var(--color-surface-hover);
  }

  .features-section,
  .tools-section {
    padding: var(--space-12) 0;
  }

  .section-header {
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cards-grid,
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card,
  .tool-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .feature-card:hover,
  .tool-card:hover {
    border-color: var(--color-indigo-500);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
  }

  .card-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .card-badge.indigo {
    background-color: rgba(99, 102, 241, 0.15);
    color: var(--color-indigo-400);
  }

  .card-badge.emerald {
    background-color: rgba(16, 185, 129, 0.15);
    color: var(--color-emerald-400);
  }

  .card-badge.cyan {
    background-color: rgba(6, 182, 212, 0.15);
    color: var(--color-cyan-400);
  }

  .card-badge.slate {
    background-color: rgba(148, 163, 184, 0.15);
    color: var(--color-slate-300);
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .card-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .card-link-row {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-indigo-400);
  }

  .trust-section {
    padding: var(--space-8) 0 var(--space-16);
  }

  .trust-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  @media (min-width: 768px) {
    .trust-box {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .trust-icon {
    font-size: 24px;
    margin-bottom: var(--space-1);
  }

  .trust-title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
  }

  .trust-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }
</style>
