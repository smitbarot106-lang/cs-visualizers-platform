---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested algorithm visualizer or developer tool coordinate could not be found."
  currentRoute="/404"
>
  <div class="not-found-container">
    <div class="not-found-badge">ERROR CODE 404</div>
    <h1 class="not-found-title">NODE NOT FOUND</h1>
    <p class="not-found-lead">
      The algorithm visualizer, developer tool, or educational guide you are attempting to inspect does not exist at this path.
    </p>

    <div class="actions-row">
      <a href="/" class="btn-home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Return to Platform Overview</span>
      </a>
      <a href="/visualizers/" class="btn-explore">
        <span>Explore All Visualizers</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    max-width: 600px;
    margin: var(--space-16) auto;
    padding: var(--space-8) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .not-found-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-amber-400);
    background-color: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
  }

  .not-found-title {
    font-family: var(--font-sans);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  .not-found-lead {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .actions-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-4);
  }

  @media (min-width: 480px) {
    .actions-row {
      flex-direction: row;
      justify-content: center;
      width: auto;
    }
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--color-brand-600);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .btn-home:hover {
    background-color: var(--color-brand-500);
  }

  .btn-explore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .btn-explore:hover {
    border-color: var(--color-brand-500);
  }
</style>
