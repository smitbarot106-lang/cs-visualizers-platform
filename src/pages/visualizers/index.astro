---
// ============================================================================
// Algorithm Visualizers Directory (Route: /visualizers/)
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';

const VISUALIZERS = [
  {
    title: 'Binary Search Visualizer',
    category: 'SEARCH ALGORITHMS',
    badge: 'O(log n) Time',
    theme: 'cyan',
    href: '/visualizers/binary-search/',
    description: 'Track Low, Mid, and High pointers step-by-step. Observe range halving, integer overflow prevention, and synchronized pseudocode.',
    highlights: ['Low / Mid / High Pointers', 'Discarded Interval Dimming', 'Reversible O(1) Scrubbing', 'Precomputed Snapshots'],
  },
  {
    title: 'Comparison Sorting Visualizer',
    category: 'SORTING ALGORITHMS',
    badge: 'Bubble • Selection • Insertion',
    theme: 'indigo',
    href: '/visualizers/sorting/',
    description: 'Observe Bubble Sort, Selection Sort, and Insertion Sort. Compare element comparisons, swaps, key shifts, and stability trade-offs.',
    highlights: ['Interactive Bar Scaling', 'Comparisons vs Swaps Counters', 'Early Exit Detection', 'Stability Demonstrations'],
  },
  {
    title: 'BFS & DFS Graph Visualizer',
    category: 'GRAPH THEORY',
    badge: 'Queue vs Stack',
    theme: 'purple',
    href: '/visualizers/bfs-dfs/',
    description: 'Explore Breadth-First and Depth-First search. Contrast FIFO Queue level exploration with LIFO Stack branch diving.',
    highlights: ['SVG Graph Layout', 'Live Queue & Stack Inspector', 'Cycle Loop Prevention', 'Disconnected Detection'],
  },
];
---

<BaseLayout
  title="Algorithm Visualizers Directory — Interactive CS Foundations"
  description="Explore interactive step-by-step algorithm visualizers for binary search, comparison sorting, and graph traversals."
  currentRoute="/visualizers/"
>
  <div class="visualizers-directory container">
    <header class="directory-header">
      <div class="header-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>INTERACTIVE STEP ENGINES • ZERO TRACKING</span>
      </div>
      <h1 class="directory-title">Algorithm Visualizers</h1>
      <p class="directory-lead">
        Step through fundamental computer science algorithms with deterministic, reversible playback, synchronized pseudocode, and real-time variable inspection.
      </p>
    </header>

    <div class="visualizers-grid">
      {VISUALIZERS.map(v => (
        <article class="visualizer-card">
          <div class="card-meta">
            <span class={`theme-pill ${v.theme}`}>{v.category}</span>
            <span class="badge-pill">{v.badge}</span>
          </div>

          <h2 class="card-title">
            <a href={v.href}>{v.title}</a>
          </h2>

          <p class="card-desc">{v.description}</p>

          <ul class="highlights-list">
            {v.highlights.map(h => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <div class="card-footer">
            <a href={v.href} class="btn-launch">
              <span>Launch Visualizer</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .visualizers-directory {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .directory-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto var(--space-12);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    background-color: rgba(190, 229, 75, 0.08);
    border: 1px solid rgba(190, 229, 75, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-brand-400);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-brand-400);
    border-radius: 50%;
  }

  .directory-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
  }

  .directory-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .visualizers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .visualizers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .visualizer-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .visualizer-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .theme-pill {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }
  .theme-pill.cyan {
    color: var(--color-cyan-400);
    background-color: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
  }
  .theme-pill.indigo {
    color: var(--color-brand-400);
    background-color: rgba(190, 229, 75, 0.1);
    border: 1px solid rgba(190, 229, 75, 0.2);
  }
  .theme-pill.purple {
    color: var(--color-purple-400);
    background-color: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .badge-pill {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-slate-300);
    background-color: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-2);
  }

  .card-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }
  .card-title a:hover {
    color: var(--color-brand-400);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-slate-300);
    flex: 1;
  }
  .highlights-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .card-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .btn-launch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px; /* Accessible 44px touch target */
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-text);
    background-color: var(--color-primary-600);
    border: 1px solid var(--color-primary-500);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }
  .btn-launch:hover {
    background-color: var(--color-primary-500);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(190, 229, 75, 0.3);
  }
</style>
