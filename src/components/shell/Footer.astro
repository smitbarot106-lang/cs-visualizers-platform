---
// ============================================================================
// Footer — Global Application Footer
// ============================================================================
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <p class="footer-wordmark" aria-hidden="true">
          <span class="prompt">&gt;_</span> cs<span class="slash">/</span>visualizers
        </p>
        <p class="footer-tagline">Don&apos;t just see the answer — understand how it works.</p>
        <p class="privacy-line">
          <span class="privacy-dot" aria-hidden="true"></span>
          100% client-side. No telemetry. No trackers.
        </p>
      </div>

      <div class="footer-nav-col">
        <h2 class="footer-col-heading">Visualizers</h2>
        <ul class="footer-links">
          <li><a href="/visualizers/binary-search/">Binary Search</a></li>
          <li><a href="/visualizers/sorting/">Sorting Algorithms</a></li>
          <li><a href="/visualizers/bfs-dfs/">BFS &amp; DFS Graphs</a></li>
          <li><a href="/visualizers/">All visualizers</a></li>
        </ul>
      </div>

      <div class="footer-nav-col">
        <h2 class="footer-col-heading">Developer Tools</h2>
        <ul class="footer-links">
          <li><a href="/tools/json-formatter/">JSON Formatter &amp; Validator</a></li>
          <li><a href="/tools/number-base-converter/">Number Base Converter</a></li>
          <li><a href="/tools/">Tool directory</a></li>
        </ul>
      </div>

      <div class="footer-nav-col">
        <h2 class="footer-col-heading">Platform</h2>
        <ul class="footer-links">
          <li><a href="/guides/">Guides &amp; Big-O Cheat Sheet</a></li>
          <li><a href="/about/">About &amp; Mission</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom-bar">
      <p>© {new Date().getFullYear()} Interactive CS Visualizers. Free and open educational platform.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-slate-950);
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0 var(--space-6);
    margin-top: auto;
  }

  .footer-container {
    width: 100%;
    max-width: var(--container-max);
    min-width: 0;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .footer-wordmark .prompt,
  .footer-wordmark .slash {
    color: var(--color-brand-400);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 30ch;
  }

  .privacy-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .privacy-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-brand-400);
    flex-shrink: 0;
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-size: var(--text-sm);
    color: var(--color-slate-300);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-brand-400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom-bar {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  @media (max-width: 480px) {
    .footer-container {
      padding: 0 var(--space-4);
    }
  }
</style>
