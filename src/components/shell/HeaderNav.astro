---
// ============================================================================
// HeaderNav — Primary Navigation Bar
// Wordmark, underline-indicator nav links, search trigger, mobile drawer toggle
// ============================================================================

interface Props {
  currentRoute?: string;
}

const { currentRoute = '/' } = Astro.props;

const NAV_LINKS = [
  { href: '/visualizers/', label: 'Visualizers' },
  { href: '/tools/', label: 'Dev Tools' },
  { href: '/guides/', label: 'Guides & Big-O' },
  { href: '/about/', label: 'About' },
];
---

<header id="site-header" class="site-header" role="banner">
  <div class="header-container">
    <a href="/" class="brand-link" aria-label="CS Visualizers Home">
      <span class="brand-prompt" aria-hidden="true">&gt;_</span>
      <span class="brand-name">cs<span class="brand-slash">/</span>visualizers</span>
    </a>

    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {NAV_LINKS.map(link => {
          const isActive = currentRoute === link.href || (link.href !== '/' && currentRoute.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`nav-link ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="search-trigger-btn"
        id="search-trigger-btn"
        aria-label="Search visualizers and tools"
        data-search-trigger
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-label">Search</span>
        <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
      </button>

      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-drawer-toggle"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        data-drawer-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Global search shortcut handler (Ctrl+K or Cmd+K or /)
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    const isCtrlK = (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k';
    const isSlash = e.key === '/' && !['INPUT', 'TEXTAREA'].includes((document.activeElement?.tagName || ''));

    if (isCtrlK || isSlash) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('open-search-modal', {
        bubbles: true,
        detail: { triggeredFrom: 'keyboard' }
      }));
    }
  });

  const searchBtn = document.getElementById('search-trigger-btn');
  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-search-modal', {
        bubbles: true,
        detail: { triggeredFrom: 'button' }
      }));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(14, 16, 14, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: 56px;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .header-container {
    width: 100%;
    max-width: var(--container-max);
    min-width: 0;
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text);
    min-width: 0;
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .brand-prompt {
    color: var(--color-brand-400);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .brand-name {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-slash {
    color: var(--color-brand-400);
    margin: 0 1px;
  }

  .desktop-nav {
    display: none;
    height: 100%;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: stretch;
    gap: var(--space-1);
    height: 100%;
  }

  .nav-list li {
    display: flex;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: -1px;
    height: 2px;
    background: var(--color-brand-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-normal);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    background: var(--color-slate-600);
  }

  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active::after {
    transform: scaleX(1);
    background: var(--color-brand-400);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .search-trigger-btn {
    display: none;
    align-items: center;
    gap: var(--space-2);
    height: 32px;
    padding: 0 var(--space-2) 0 var(--space-3);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  @media (min-width: 640px) {
    .search-trigger-btn {
      display: inline-flex;
    }
  }

  .search-trigger-btn:hover {
    border-color: var(--color-brand-400);
    color: var(--color-text);
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 1px 6px;
    background-color: var(--color-slate-850);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-slate-400);
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 0;
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-menu-btn:hover {
    color: var(--color-brand-400);
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0 var(--space-4);
    }
    .brand-name {
      font-size: var(--text-sm);
    }
  }
</style>
