---
// ============================================================================
// BaseLayout — Main Application Document Shell
// Strict sibling landmark structure: #page-shell and #modal-portal
// ============================================================================

import '../styles/tokens.css';
import '../styles/fonts.css';
import SkipToContent from '../components/common/SkipToContent.astro';
import HeaderNav from '../components/shell/HeaderNav.astro';
import Footer from '../components/shell/Footer.astro';
import MobileDrawer from '../components/shell/MobileDrawer.astro';
import SearchModal from '../components/search/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  currentRoute?: string;
}

const {
  title,
  description = "Don't just see the answer — understand how it works. Interactive algorithm visualizers and privacy-first developer tools.",
  currentRoute = '/',
} = Astro.props;

const pageTitle = title
  ? `${title} | CS Visualizers Platform`
  : 'CS Visualizers Platform — Interactive Algorithms & Privacy-First DevTools';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CS Visualizers Platform" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <!-- Sibling Landmark: #page-shell is made inert when dialogs/drawers open -->
    <div id="page-shell">
      <SkipToContent />
      <HeaderNav currentRoute={currentRoute} />

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <!-- Sibling Landmark: #modal-portal for modals and overlays -->
    <div id="modal-portal">
      <MobileDrawer currentRoute={currentRoute} />
      <SearchModal />
    </div>
  </body>
</html>

<style is:global>
  /* --------------------------------------------------------------------------
     Global CSS Reset & Document Base
     -------------------------------------------------------------------------- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-wrap: break-word;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    background-color: var(--color-bg);
    color: var(--color-text);
    overflow-x: hidden;
  }

  /* Global link reset to prevent browser default blue/purple links */
  a {
    color: inherit;
    text-decoration: none;
  }

  #page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    position: relative;
    transition: opacity var(--transition-normal);
  }

  #main-content {
    flex: 1 0 auto;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    outline: none;
  }

  #page-shell[inert] {
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
    opacity: 0.6;
  }

  /* Accessible focus indicators */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  /* Utility Container */
  .container {
    width: 100%;
    max-width: var(--container-max);
    min-width: 0;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  @media (max-width: 480px) {
    .container {
      padding-left: var(--space-3);
      padding-right: var(--space-3);
    }
  }

  /* Global Table Scroll Wrapper Confinement */
  .table-scroll-wrapper {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
</style>
